[Unit]
Description=Cinba Core

[Service]
Type=simple
WorkingDirectory=%h/current
Environment=PATH=%h/.local/node/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/node/bin/node %h/current/packages/server/src/service-entry.ts
Restart=on-failure
RestartSec=5s
TimeoutStopSec=16min

[Install]
WantedBy=default.target
