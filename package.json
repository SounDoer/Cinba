{
  "name": "cinba",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "A personal multi-interface AI coding agent built on pi.dev.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SounDoer/Cinba.git"
  },
  "homepage": "https://github.com/SounDoer/Cinba#readme",
  "bugs": {
    "url": "https://github.com/SounDoer/Cinba/issues"
  },
  "bin": {
    "cinba": "scripts/cinba.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node scripts/launch.ts start",
    "desktop": "node scripts/launch.ts desktop",
    "dev": "node scripts/launch.ts dev",
    "sync:dev": "node scripts/launch.ts sync",
    "tui": "node scripts/launch.ts tui",
    "promote": "node scripts/promote.ts",
    "format": "prettier --write \"packages/**/*.{ts,tsx,css,json}\" \"scripts/**/*.ts\" \"*.json\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,css,json}\" \"scripts/**/*.ts\" \"*.json\"",
    "lint": "oxlint packages scripts",
    "lint:fix": "oxlint --fix packages scripts",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.scripts.json",
    "test": "node --test --experimental-strip-types \"packages/*/src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "test:e2e": "node --test --experimental-strip-types \"packages/*/src/**/*.e2e.ts\"",
    "build": "npm run build --workspace @cinba/web && npm run build --workspace @cinba/desktop && npm run build --workspace @cinba/sync-web",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:e2e && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
