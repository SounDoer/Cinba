{
  "name": "cinba",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node scripts/launch.ts start",
    "dev": "node scripts/launch.ts dev",
    "tui": "node scripts/launch.ts tui",
    "format": "prettier --write \"packages/**/*.{ts,tsx,css,json}\" \"scripts/**/*.ts\" \"*.json\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,css,json}\" \"scripts/**/*.ts\" \"*.json\"",
    "lint": "oxlint packages scripts",
    "lint:fix": "oxlint --fix packages scripts",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.scripts.json",
    "test": "node --test --experimental-strip-types \"packages/*/src/**/*.test.ts\"",
    "test:e2e": "node --test --experimental-strip-types \"packages/*/src/**/*.e2e.ts\"",
    "build": "npm run build --workspace @cinba/web",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:e2e && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
